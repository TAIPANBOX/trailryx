#!/usr/bin/env bash
#
# Local gate before anything leaves this machine.
#
# `.github/workflows/ci.yml` runs the same checks. It was written while the
# repository was private, when Actions minutes were metered and every job was
# skipped by a condition on the repository being public; the repository went public
# on 30 July 2026 and the condition released itself. The two must not drift: a
# green push has to mean a green pull request.
#
# Install (once):  git config core.hooksPath .githooks
# Skip (rarely):   git push --no-verify

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

pass=0
fail=0

step() {
  local name="$1"
  shift
  printf '  %-34s' "$name"
  if out=$("$@" 2>&1); then
    printf 'ok\n'
    pass=$((pass + 1))
  else
    printf 'FAIL\n'
    fail=$((fail + 1))
    printf '%s\n' "$out" | sed 's/^/      /' | tail -25
  fi
}

echo "pre-push gate"

# Formatting and lints. Warnings are failures: a warning nobody fixes is a
# warning everybody stops reading.
step "cargo fmt --check" cargo fmt --all --check
step "cargo clippy -D warnings" cargo clippy --all-targets --quiet -- -D warnings
step "cargo test" cargo test --workspace --quiet

# The substrate must stand on its own. This stopped being trivially true on 30 July
# 2026, exactly as the comment here predicted it would: DataFusion and pgwire
# arrived as a facade and must never become load-bearing. The check above it is the
# broader version of the same question.
step "sim crate builds standalone" cargo test -p trailryx-sim --quiet

# Zero third-party dependencies IN THE CORE.
#
# This check used to say "workspace-wide" and it stopped being true on 30 July
# 2026, when `trailryx-sql` took DataFusion and pgwire. That was a deliberate
# decision with the architecture behind it (§3.1: compatibility wins, and §3.2a,
# which requires exactly the boundary these two checks enforce), and the honest
# response is to narrow the claim to what is still true rather than to keep
# printing the old one.
#
# What is still true, and what actually carried the argument: the offline verifier
# has to be small enough for an auditor to read, and every crate pulled in is a
# crate somebody has to trust. That was never a property of the workspace. It is a
# property of the thing an auditor reads.
# Crates allowed to carry third-party dependencies, and the reason each one may.
# A declared list rather than a single name, because the standing decision (Yurii,
# 30 July 2026) is that this project takes the best available implementation of a
# thing rather than writing its own by default. The list is the whole policy: a
# crate not on it must have none, and adding a crate to it is a decision somebody
# writes down here, not a dependency that appears in a manifest.
#
# What the list must never contain, and this is the part that carries the argument:
# the core and `trailryx-verify`. An auditor reads the verifier. Every crate pulled
# into it is a crate that auditor is asked to trust instead.
FACADE="trailryx-sql"
ALLOWED="trailryx-sql trailryx-crypto-aws"
printf '  %-34s' "zero deps outside the declared"
offenders=""
for dir in crates/*/; do
  crate=$(basename "$dir")
  case " $ALLOWED " in *" $crate "*) continue ;; esac
  n=$(cargo tree -p "$crate" --prefix none 2>/dev/null | grep -v '^trailryx' | grep -c . || true)
  if [ "$n" -ne 0 ]; then
    offenders="$offenders $crate($n)"
  fi
done
if [ -z "$offenders" ]; then
  printf 'ok\n'
  pass=$((pass + 1))
else
  printf 'FAIL%s\n' "$offenders"
  fail=$((fail + 1))
fi

# The core has to stand up with the facade absent, which §3.2a requires by name:
# if the core cannot build and pass its tests without the facade, the facade has
# got into the foundation. This is also what protects the core's determinism, and
# with it deterministic simulation testing, from tokio's scheduler.
step "core builds without the facade" \
  cargo test --workspace --exclude "$FACADE" --quiet

# No unsafe. The workspace lint forbids it, so this is a second pair of eyes on
# the lint itself rather than on the code.
printf '  %-34s' "no unsafe"
if grep -rIn --include='*.rs' -E '^\s*unsafe\b|[^a-z_]unsafe\s*\{' crates >/dev/null 2>&1; then
  printf 'FAIL\n'
  grep -rIn --include='*.rs' -E '^\s*unsafe\b|[^a-z_]unsafe\s*\{' crates | sed 's/^/      /' | head
  fail=$((fail + 1))
else
  printf 'ok\n'
  pass=$((pass + 1))
fi

# The exit criterion of stage 0, checked on every push rather than once.
# A seed must reproduce a run exactly; if that stops holding, every other
# guarantee built on the simulator stops meaning anything.
printf '  %-34s' "determinism (same seed, twice)"
run_once() {
  cargo run --quiet --bin trailryx-sim-run -- \
    --seed 20260729 --steps 800 --shards 3 --sync-every 4 \
    --crash-ppm 12000 --hostile --honest-disk 2>/dev/null
}
a=$(run_once)
b=$(run_once)
if [ -n "$a" ] && [ "$a" = "$b" ]; then
  printf 'ok  %s\n' "$(printf '%s' "$a" | tr ' ' '\n' | grep '^digest=')"
  pass=$((pass + 1))
else
  printf 'FAIL\n'
  printf '      run 1: %s\n      run 2: %s\n' "$a" "$b"
  fail=$((fail + 1))
fi

# The published seed corpus: every recorded run must still produce the digest and
# the violation count written down for it. This is a DETERMINISM check and not a
# correctness one, and the file says so: a wrong implementation reproduces
# perfectly. Its value is that a change in behaviour cannot arrive quietly.
printf '  %-34s' "seed corpus reproduces"
if corpus=$(cargo run --quiet --release --bin trailryx-sim-run -- \
              --corpus sim/corpus.tsv 2>&1); then
  printf 'ok  %s\n' "$(printf '%s' "$corpus" | head -1)"
  pass=$((pass + 1))
else
  printf 'FAIL\n'
  printf '%s\n' "$corpus" | sed 's/^/      /' | head -14
  fail=$((fail + 1))
fi

# Two verifiers, one pack. The plan asks for a second independent implementation in
# another language because two that agree prove the FORMAT rather than the author,
# and this is where they are held to the same verdict on the same bytes.
step "two verifiers agree" cargo test -p trailryx-store --test two_verifiers --quiet

# The same source must produce the same verifier binary from any directory, or an
# auditor cannot check the binary they run against the source they read. Stage 8's
# other exit criterion, and it takes about three seconds.
step "verifier build is reproducible" ./scripts/reproduce.sh

# Every number the README states about this repository, against the repository.
# Added after an audit found six drifted crate counts, a dependency figure no reading
# of the tree reproduced, and a line off by a factor of two. None of them was a lie
# when written, which is exactly why a person cannot be the check.
step "README numbers are true" ./scripts/readme-numbers.sh

# A short hunt for a durability violation. Not the long run, which belongs in a
# nightly sweep: enough to catch a write-path regression before it is pushed.
printf '  %-34s' "durability sweep (200 seeds)"
if sweep=$(cargo run --quiet --release --bin trailryx-sim-run -- \
             --seed 1 --sweep 200 --steps 300 --shards 3 --sync-every 4 \
             --crash-ppm 15000 --hostile --honest-disk 2>/dev/null); then
  printf 'ok  %s\n' "$sweep"
  pass=$((pass + 1))
else
  printf 'FAIL\n'
  printf '%s\n' "$sweep" | sed 's/^/      /' | head -10
  fail=$((fail + 1))
fi

echo
if [ "$fail" -gt 0 ]; then
  echo "pre-push: $fail failed, $pass passed. Push refused."
  echo "Override with --no-verify only if you know why."
  exit 1
fi
echo "pre-push: all $pass checks passed."
exit 0
