#!/usr/bin/env bash
#
# Local gate before anything leaves this machine.
#
# `.github/workflows/ci.yml` runs the same checks. It was written while the
# repository was private, when Actions minutes were metered and every job was
# skipped by a condition on the repository being public; the repository went public
# on 30 July 2026 and the condition released itself. The two must not drift: a
# green push has to mean a green pull request.
#
# Install (once):  git config core.hooksPath .githooks
# Skip (rarely):   git push --no-verify

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

# FIRST, before even deciding whether there is anything to do: is this the hook
# belonging to the worktree being pushed?
#
# `core.hooksPath` can be overridden per worktree with an absolute path into another
# checkout, and then this file comes from one commit while every script it calls comes
# from another, because of the `cd` above. `scripts/hooks-path.sh` says what that costs
# and prints the one command that repairs it.
#
# THE ORDER HERE IS LOAD-BEARING and the deletion shortcut below must not move above
# it. Two reasons, and the second is the one that makes it correctness rather than
# courtesy:
#
#   1. Deleting branches is when somebody is moving between worktrees, which is exactly
#      when a stale absolute `core.hooksPath` is most likely to be in force. Skipping
#      first would make that the one push where they never hear about it, and the fault
#      is silent by construction, which is the whole of invariant 30.
#   2. The decision to skip is made BY the hook whose provenance is in question. An
#      unverified hook's idea of what counts as a deletion is itself unverified: it may
#      be older than the block below, or newer, or wrong. Asking "have I anything to
#      do" before "am I the right file to be asking" takes the answer from the file
#      under suspicion.
#
# Not a `step`: it checks the gate rather than the code, it has to answer before the
# expensive checks start, and CI has no hooks for it to ask about. So it is not one of
# the checks `scripts/gate-count.sh` counts, and the two counts stay equal.
if [ -x ./scripts/hooks-path.sh ]; then
  if ! why=$(./scripts/hooks-path.sh "$0" 2>&1); then
    printf '%s\n' "$why"
    echo
    echo "pre-push: refused before running a single check."
    exit 1
  fi
else
  # The same fault seen from its other side. This hook calls a script this worktree
  # does not have, so the hook is not from the commit being pushed.
  printf 'this hook is %s\n' "$0"
  printf 'and this worktree has no scripts/hooks-path.sh for it to call, so the hook\n'
  printf 'and the tree it is checking are from different commits.\n'
  printf '\n'
  printf '  git config --worktree --unset core.hooksPath\n'
  echo
  echo "pre-push: refused before running a single check."
  exit 1
fi

# A push that only deletes refs has nothing to check, and checking it anyway is not
# free. Measured on 6 August 2026 while removing four merged branches: `git push
# --delete` ran the entire gate, the first one was abandoned after five minutes, and
# the remaining three were done with `--no-verify`. That is the wrong habit to build,
# because `--no-verify` is the same keystroke whether the push carries nothing or
# carries everything, and a gate people have learned to bypass is not a gate.
#
# The decision itself is `scripts/deletion-only-push.sh`, which reads the stdin git
# feeds this hook, and it is a separate file for a reason that is not tidiness: a check
# the gate runs cannot test this hook by running it, because the cases whose correct
# answer is "run everything" would run the gate, which would run the check. Those are
# the cases that matter, so the decision had to move somewhere a check can reach it.
# `scripts/deletion-skip-cases.sh` is that check, and invariant 32 is the rule.
#
# If the script is absent this hook checks everything, which is the safe direction and
# the same answer the decision gives when it cannot tell.
if [ -x ./scripts/deletion-only-push.sh ]; then
  if refs=$(./scripts/deletion-only-push.sh); then
    # Said out loud rather than exiting quietly. A gate that declines to run has to
    # report that it declined, or it is indistinguishable from one that passed.
    printf 'pre-push: %s ref(s) and every one a deletion, so no check ran.\n' "$refs"
    exit 0
  fi
fi

pass=0
fail=0

step() {
  local name="$1"
  shift
  printf '  %-34s' "$name"
  if out=$("$@" 2>&1); then
    printf 'ok\n'
    pass=$((pass + 1))
  else
    printf 'FAIL\n'
    fail=$((fail + 1))
    printf '%s\n' "$out" | sed 's/^/      /' | tail -25
  fi
}

# The same, but printing what the check measured rather than only that it passed.
# For the three that produce a number somebody compares against something: a digest,
# a corpus line, a sweep result. A check that only says "ok" is a check nobody can
# compare against anything, and these three said more than "ok" before they moved
# into scripts.
say() {
  local name="$1"
  shift
  printf '  %-34s' "$name"
  if out=$("$@" 2>&1); then
    printf 'ok  %s\n' "$(printf '%s' "$out" | tail -1)"
    pass=$((pass + 1))
  else
    printf 'FAIL\n'
    fail=$((fail + 1))
    printf '%s\n' "$out" | sed 's/^/      /' | tail -25
  fi
}

echo "pre-push gate"

# Formatting and lints. Warnings are failures: a warning nobody fixes is a
# warning everybody stops reading.
step "cargo fmt --check" cargo fmt --all --check
step "cargo clippy -D warnings" cargo clippy --all-targets --quiet -- -D warnings
step "cargo test" cargo test --workspace --quiet

# The substrate must stand on its own. This stopped being trivially true on 30 July
# 2026, exactly as the comment here predicted it would: DataFusion and pgwire
# arrived as a facade and must never become load-bearing. The check above it is the
# broader version of the same question.
step "sim crate builds standalone" cargo test -p trailryx-sim --quiet

# Zero third-party dependencies IN THE CORE.
#
# This check used to say "workspace-wide" and it stopped being true on 30 July
# 2026, when `trailryx-sql` took DataFusion and pgwire. That was a deliberate
# decision with the architecture behind it (§3.1: compatibility wins, and §3.2a,
# which requires exactly the boundary these two checks enforce), and the honest
# response is to narrow the claim to what is still true rather than to keep
# printing the old one.
#
# What is still true, and what actually carried the argument: the offline verifier
# has to be small enough for an auditor to read, and every crate pulled in is a
# crate somebody has to trust. That was never a property of the workspace. It is a
# property of the thing an auditor reads.
# Crates allowed to carry third-party dependencies, and the reason each one may.
# A declared list rather than a single name, because the standing decision (Yurii,
# 30 July 2026) is that this project takes the best available implementation of a
# thing rather than writing its own by default. The list is the whole policy: a
# crate not on it must have none, and adding a crate to it is a decision somebody
# writes down here, not a dependency that appears in a manifest.
#
# What the list must never contain, and this is the part that carries the argument:
# the core and `trailryx-verify`. An auditor reads the verifier. Every crate pulled
# into it is a crate that auditor is asked to trust instead.
step "zero deps outside the declared" ./scripts/declared-deps.sh

# The core has to stand up with every adapter absent, which §3.2a requires by name
# for the facade and §2a extends to the rest: if the core cannot build and pass its
# tests without them, an adapter has got into the foundation. This is also what protects the core's determinism, and
# with it deterministic simulation testing, from tokio's scheduler.
# shellcheck disable=SC2046,SC2086
step "core builds without adapters" \
  cargo test --workspace $(./scripts/declared-deps.sh list) --quiet

# No unsafe, in one file this hook and CI both call.
step "no unsafe" ./scripts/no-unsafe.sh

# No fixture builds a temp path a second process would build too. This is here
# because of what it costs when it is not: two pushes refused by a panic that named a
# missing file and not the run that had removed it, and an hour spent on a test that
# was correct. `$TMPDIR` is shared by every process one user runs, so a fixture named
# after itself and nothing else is a fixture two runs share.
say "temp paths are per process" ./scripts/temp-paths.sh

# The debt the check above took on. A constant path nothing deletes is one stale
# directory; the same path with a process id in it is a new one on every run, and the
# worst of them held a private key per fixture per run.
say "scratch paths are cleaned up" ./scripts/scratch-cleanup.sh

# No test waits without a bound. A hanging test reports nothing at all: no failure, no
# name, no output, which is less than a wrong answer tells you. Cheap, and it found a
# live one the first time it ran.
say "waits in tests are bounded" ./scripts/bounded-waits.sh

# The shortcut at the top of this file, against the cases it must and must not take.
# It is the one check here whose subject is the gate rather than the code, and it is
# here rather than earlier because it is not a precondition: by the time it runs the
# decision has already been made correctly or this push would not be checking anything.
say "the deletion shortcut is honest" ./scripts/deletion-skip-cases.sh

# How many checks this file runs, against how many CI runs, and against the one place
# a reader is told. The header above promises a green push is a green pull request and
# nothing counted the two sides until now. It also holds the number in prose down to
# one file: it moved three times in one day and cost five hand edits each time.
say "the gate's own count" ./scripts/gate-count.sh

# Every field of every configuration struct, against the code meant to read it. A
# bound that nothing reads is worse than an absent one: the reason written beside it
# reads as a mitigation somebody has already applied, and the sentence is what gets
# believed. `Config::max_connections` on the SQL surface was that for four days.
say "configuration fields are read" ./scripts/config-fields.sh

# The exit criterion of stage 0, checked on every push rather than once, in one
# file this hook and CI both call. A seed must reproduce a run exactly; if that
# stops holding, every other guarantee built on the simulator stops meaning
# anything.
say "determinism (same seed, twice)" ./scripts/determinism.sh

# The published seed corpus, in one file this hook and CI both call. A DETERMINISM
# check and not a correctness one, and the corpus file says so: a wrong
# implementation reproduces perfectly. Its value is that a change in behaviour
# cannot arrive quietly.
say "seed corpus reproduces" ./scripts/seed-corpus.sh

step "two verifiers agree" cargo test -p trailryx-store --test two_verifiers --quiet

# The same source must produce the same verifier binary from any directory, or an
# auditor cannot check the binary they run against the source they read. Stage 8's
# other exit criterion, and it takes about three seconds.
step "verifier build is reproducible" ./scripts/reproduce.sh

# A feature nobody builds is a feature that rots. The default build of the HTTP
# client has no dependencies, which is what the check above measures, so the TLS
# build has to be exercised separately or it would break silently and only in a
# deployment.
step "the TLS builds still work" ./scripts/tls-builds.sh

# The same argument with more at stake. `Vault::new` refuses any cipher and key source
# that answer `is_validated() == false`, and both answer `cfg!(feature = "fips")`, so
# that feature is not an extra: it is the only configuration in which this store may be
# used at all. Nothing here compiled it until 7 August 2026, which means the one build
# a deployment runs had never been built. It announces a skip out loud on a machine
# without CMake and Go; CI sets TRAILRYX_FIPS_REQUIRED=1 and cannot skip.
say "the fips build still works" ./scripts/fips-build.sh

# Every hand-written parser, fed bytes it did not expect, from a seed anybody can
# rerun. Stage 13 asks for this; the usual answer needs a nightly compiler and
# produces a corpus nobody can replay from a commit message, and this project
# already had the better half of that machinery.
step "parsers survive hostile bytes" \
  cargo test -p trailryx-fuzz --quiet

# Every number the README states about this repository, against the repository.
# Added after an audit found six drifted crate counts, a dependency figure no reading
# of the tree reproduced, and a line off by a factor of two. None of them was a lie
# when written, which is exactly why a person cannot be the check.
step "README numbers are true" ./scripts/readme-numbers.sh

# A short hunt for a durability violation, in one file this hook and CI both call.
# Not the long run, which lives in VALIDATION.md: enough to catch a write-path
# regression before it is pushed.
say "durability sweep (200 seeds)" ./scripts/durability-sweep.sh

# Advisories, and the reasons the silenced ones are silenced. CI had this and
# this hook did not, which is the drift the header above says must not happen:
# sixteen green checks locally, a red gate on the runner, and an afternoon spent
# on a difference that was never a decision.
#
# The half of the script that needs the network and cargo-audit announces itself
# as skipped when either is missing, rather than turning every push into a
# round trip. The half that re-derives each ignore's reason is `cargo tree`
# against the manifest on disk, and that half always runs.
say "advisories, and the silenced ones" ./scripts/audit.sh

echo
if [ "$fail" -gt 0 ]; then
  echo "pre-push: $fail failed, $pass passed. Push refused."
  echo "Override with --no-verify only if you know why."
  exit 1
fi
echo "pre-push: all $pass checks passed."
exit 0
